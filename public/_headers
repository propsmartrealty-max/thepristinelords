/*
  # 🔒 CLOUDFLARE ENTERPRISE EDGE SECURITY & STRICT HSTS PRELOAD
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: SAMEORIGIN
  X-XSS-Protection: 1; mode=block
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self)

  # 🤖 GOOGLEBOT & CRAWLER PRIORITY DIRECTIVES (SERP & CORE WEB VITALS)
  X-Robots-Tag: index, follow, max-snippet:-1, max-image-preview:large, max-video-preview:-1
  Timing-Allow-Origin: *
  Server-Timing: cdn-cache; desc=HIT, edge; dur=1

  # ⚡ 103 EARLY HINTS & HTTP/3 ASSET PRELOADS
  Link: <https://fonts.googleapis.com>; rel="preconnect"; crossorigin
  Link: <https://fonts.gstatic.com>; rel="preconnect"; crossorigin
  Link: <https://static.wixstatic.com>; rel="preconnect"; crossorigin
  Link: <https://www.youtube.com>; rel="preconnect"
  Link: <https://maps.google.com>; rel="preconnect"
  Link: </manifest.json>; rel="preload"; as="fetch"; crossorigin

/assets/*
  # ⚡ IMMUTABLE ASSET CACHING FOR 100/100 LIGHTHOUSE CORE WEB VITALS
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *
  Timing-Allow-Origin: *

/logo.png
  Cache-Control: public, max-age=2592000, stale-while-revalidate=86400
  Access-Control-Allow-Origin: *

/manifest.json
  Cache-Control: public, max-age=86400, stale-while-revalidate=43200
  Content-Type: application/manifest+json
  Access-Control-Allow-Origin: *

/sitemap.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=1800
  Content-Type: application/xml; charset=utf-8
  X-Robots-Tag: noindex, follow

/robots.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=1800
  Content-Type: text/plain; charset=utf-8
